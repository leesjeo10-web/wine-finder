# Copy these names into Render > Environment (do not commit actual secrets).
# MySQL must be reachable from Render; localhost on your Mac will not work.
DB_URL=jdbc:mysql://YOUR_MYSQL_HOST:3306/wine_finder
DB_USERNAME=YOUR_MYSQL_USER
DB_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD

# Render supplies PORT automatically. Defaults to 8080 locally.
PORT=8080
# Use your actual frontend origin (scheme + host; no trailing slash).
FRONTEND_ORIGINS=https://YOUR_FRONTEND_HOST
COOKIE_SECURE=true
# Render free instances have ephemeral storage; uploaded photos may disappear.
UPLOAD_DIR=./uploads
